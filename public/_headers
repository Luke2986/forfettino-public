# Service Worker files — MAI cache-are.
# Questi file DEVONO essere sempre fetched fresh dal server, altrimenti
# il browser serve un SW obsoleto e gli utenti restano bloccati su build
# vecchie anche dopo un nuovo deploy.
# Formato compatibile con Netlify e Cloudflare Pages.

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# Asset con hash nel nome sono immutabili: possono essere cachati per sempre
/assets/*
  Cache-Control: public, max-age=31536000, immutable
