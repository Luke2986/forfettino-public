{
  "rewrites": [
    { "source": "/calcolatore-forfettario", "destination": "/calcolatore-forfettario/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/glossario", "destination": "/glossario/index.html" },
    { "source": "/pro-presto", "destination": "/pro-presto/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/cookie-policy", "destination": "/cookie-policy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/reset-password", "destination": "/reset-password/index.html" },
    { "source": "/conferma-email", "destination": "/conferma-email/index.html" },
    { "source": "/auth/callback", "destination": "/auth/callback/index.html" },
    { "source": "/bento-demo", "destination": "/bento-demo/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
